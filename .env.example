# Copia este archivo como .env. Nunca uses el prefijo VITE_ para secretos.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/travesia.sqlite
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# En producción: NODE_ENV=production, APP_ORIGIN=https://tu-dominio.cl,
# HOST=0.0.0.0 si lo requiere tu hosting, y disco persistente para DATABASE_PATH.
# Si hay un proxy de confianza delante, indica su número exacto de saltos.
TRUST_PROXY_HOPS=0

# Para Supabase, cambia a supabase y completa estas variables solo en .env y Vercel.
STORAGE_PROVIDER=sqlite
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# En Vercel: STORAGE_PROVIDER=supabase y APP_ORIGIN=https://demo-eventos-liard.vercel.app
# Usa la clave sb_secret_... de Supabase; service_role es compatible como alternativa.
# No uses VITE_SUPABASE_SECRET_KEY ni publiques la clave en el frontend o en Git.
